---
/*
  Mockup images are provided by shots.so
  Link: https://shots.so/
*/

import Image from "astro/components/Image.astro";
const { t } = Astro.props as { t: (key: string) => string };
import { projects } from "@/data/projects";
---

<section
  id="Projects"
  class="relative overflow-hidden bg-foreground w-full text-center flex flex-col justify-center items-center gap-10 px-4 py-24 sm:py-24 select-none"
>
  <h2
    class="z-10 w-full max-w-xl sm:text-center text-lg sm:text-2xl md:text-4xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-b from-background via-background to-muted-foreground"
  >
    {t("projects.title")}
  </h2>
  <p
    class="w-full max-w-xl bg-clip-text text-transparent bg-gradient-to-b from-background via-background to-muted-foreground sm:text-center text-normal sm:text-lg md:text-xl font-light tracking-tighter text-balance"
  >
    {t("projects.subtitle")}
  </p>
  <div class="z-10 w-full grid grid-cols-1 md:grid-cols-5 grid-rows-6 gap-2">
    <article
      class="overflow-hidden relative bg-dark-card col-span-1 md:col-span-3 md:row-span-2 border h-[300px] border-dark-border rounded-[1rem] flex flex-col lg:flex-row lg:gap-3"
    >
      <div class="flex flex-col gap-2 w-full items-start p-4 tetx-left">
        <h3
          class="text-left sm:text-xl md:text-2xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-br from-background via-background to-secondary"
        >
          <a
            href="https://demo-artist-folio.vercel.app/"
            target="_blank"
            rel="noopener noreferrer">{t("proyect1.title")}</a
          >
        </h3>
        <p
          class="w-full text-muted-foreground text-left text-sm sm:text-normal md:text-lg font-light tracking-tighter text-balance"
        >
          {t("proyect1.description")}
        </p>
      </div>
      <div class="aspect-video">
        <a
          href="https://demo-artist-folio.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Image
            src="/assets/ArtistFolio.png"
            alt="Mockup Project"
            loading="lazy"
            width={1920}
            height={1080}
            draggable="false"
            class="object-contain w-full h-full rounded-md hover:scale-105 duration-500 transition-all"
          />
        </a>
      </div>
    </article>
    <article
      class="overflow-hidden group bg-dark-card col-span-1 md:col-span-2 md:row-span-2 md:col-start-4 h-[300px] border border-dark-border rounded-[1rem] p-4 flex flex-col flex-1 gap-2 justify-center items-center"
    >
      <div
        class="w-fit rounded-full bg-background px-4 py-2 flex justify-center items-center rotate-12 group-hover:rotate-0 border transition-all duration-300 ease-in-out"
      >
        <span
          class="text-normal sm:text-lg md:text-xl font-light tracking-tighter"
        >
          {t("softskills1")}
        </span>
      </div>
      <div
        class="w-fit rounded-full bg-background px-4 py-2 flex justify-center items-center -rotate-6 group-hover:rotate-0 border transition-all duration-300 ease-in-out"
      >
        <span
          class="text-normal sm:text-lg md:text-xl font-light tracking-tighter"
        >
          {t("softskills2")}
        </span>
      </div>
      <div
        class="w-fit rounded-full bg-background px-4 py-2 flex justify-center items-center border"
      >
        <span
          class="text-normal sm:text-lg md:text-xl font-light tracking-tighter"
        >
          {t("softskills3")}
        </span>
      </div>
      <div
        class="w-fit rounded-full bg-background px-4 py-2 flex justify-center items-center border rotate-12 group-hover:rotate-0 transition-all duration-300 ease-in-out"
      >
        <span
          class="text-normal sm:text-lg md:text-xl font-light tracking-tighter"
        >
          {t("softskills4")}
        </span>
      </div>
    </article>
    <article
      class="overflow-hidden bg-dark-card col-span-1 md:col-span-2 md:row-span-2 md:row-start-3 border h-[300px] border-dark-border rounded-[1rem] px-4 group"
    >
      <div
        class="w-full h-fit max-h-[500px] flex flex-col justify-center select-none overflow-hidden"
      >
        <div
          class="w-full h-max flex flex-col justify-center items-center gap-[4rem] animate-vertical-slide"
        >
          {
            projects.map((p) => (
              <article class="w-full max-w-sm flex flex-col gap-2 items-center justify-center min-h-20 border border-dark-border bg-background rounded-[1rem] px-4 py-2">
                <div class="w-full flex items-start gap-2">
                  <Image
                    src={p.image}
                    alt={p.alt}
                    width={32}
                    height={32}
                    loading="lazy"
                    class="object-contain w-8 h-8 rounded-full bg-gradient-to-r from-primary to-secondary"
                  />
                  <div class="flex-1 min-w-0 text-left">
                    <h3 class="text-sm font-medium truncate">{p.name}</h3>
                    <p class="w-full text-muted-foreground text-xs line-clamp-2">
                      {t?.(`projects.${p.id}.testimonial`) ??
                        `MISSING t / id=${p.id}`}
                    </p>
                  </div>
                </div>
                <a
                  href={p.src}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="self-start ml-9 text-blue-800 hover:text-blue-950 text-xs hover:underline hover:translate-x-2 transition duration-300"
                >
                  {t("project.list")}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </article>
    <article
      class="overflow-hidden bg-dark-card col-span-1 md:col-span-3 md:row-span-2 md:col-start-3 md:row-start-3 border h-[300px] border-dark-border rounded-[1rem] flex flex-col lg:flex-row lg:gap-3"
    >
      <div class="flex flex-col gap-2 w-full items-start p-4 tetx-left">
        <h3
          class="text-left sm:text-xl md:text-2xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-br from-background via-background to-secondary"
        >
          <a
            href="https://cancun-safe-place.vercel.app/"
            target="_blank"
            rel="noopener noreferrer">{t("proyect2.title")}</a
          >
        </h3>
        <p
          class="w-full text-muted-foreground text-left text-sm sm:text-normal md:text-lg font-light tracking-tighter text-balance"
        >
          {t("proyect2.description")}
        </p>
      </div>
      <div class="aspect-video">
        <a
          href="https://cancun-safe-place.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
          ><Image
            src="/assets/SafePlace2.png"
            alt="SafePlace WebSite"
            loading="lazy"
            width={1920}
            height={1080}
            draggable="false"
            class="object-contain w-full h-full rounded-md hover:scale-105 duration-500 transition-all"
          /></a
        >
      </div>
    </article>
    <article
      class="overflow-hidden bg-dark-card col-span-1 md:col-span-3 md:row-span-2 md:row-start-5 border h-[300px] border-dark-border rounded-[1rem] flex flex-col lg:flex-row lg:gap-3"
    >
      <div class="flex flex-col gap-2 w-full items-start p-4 tetx-left">
        <h3
          class="text-left sm:text-xl md:text-2xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-br from-background via-background to-secondary"
        >
          <a
            href="https://teecback.vercel.app/"
            target="_blank"
            rel="noopener noreferrer">{t("proyect3.title")}</a
          >
        </h3>
        <p
          class="w-full text-muted-foreground text-left text-sm sm:text-normal md:text-lg font-light tracking-tighter text-balance"
        >
          {t("proyect3.description")}
        </p>
      </div>
      <div class="aspect-video">
        <a
          href="https://teecback.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
          ><Image
            src="/assets/TeecBack3.png"
            alt="TeecBack"
            loading="lazy"
            width={1920}
            height={1080}
            class="object-contain w-full h-full rounded-md hover:scale-105 duration-500 transition-all"
            draggable="false"
          /></a
        >
      </div>
    </article>
    <article
      class="overflow-hidden bg-dark-card col-span-1 md:col-span-2 md:row-span-2 md:col-start-4 md:row-start-5 border h-[300px] border-dark-border rounded-[1rem]"
    >
      <div
        class="w-full h-full flex flex-col gap-5 justify-center items-center"
      >
        <h1
          class="sm:text-xl md:text-2xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-br from-background via-background to-secondary"
        >
          {t("calltoaction.title")}
        </h1>
        <a
          href="https://x.com/Rasen_bunkai"
          target="_blank"
          rel="noopener noreferrer"
          class="w-fit flex gap-2 justify-center items-center px-4 py-2 sm:text-lg font-medium text-background bg-primary rounded-full hover:scale-105 duration-300 transition-all"
        >
          Twitter
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="1200"
            height="1227"
            fill="none"
            class="size-5"
            viewBox="0 0 1200 1227"
            ><path
              fill="#fff"
              d="M714.163 519.284 1160.89 0h-105.86L667.137 450.887 357.328 0H0l468.492 681.821L0 1226.37h105.866l409.625-476.152 327.181 476.152H1200L714.137 519.284h.026ZM569.165 687.828l-47.468-67.894-377.686-540.24h162.604l304.797 435.991 47.468 67.894 396.2 566.721H892.476L569.165 687.854v-.026Z"
            ></path></svg
          >
        </a>
      </div>
    </article>
  </div>
  <div
    class="bg-white opacity-10 absolute size-80 top-[-160px] border blur-[150px] rounded-full"
  >
  </div>
</section>

<style>
  .group:hover .animate-vertical-slide {
    animation-play-state: paused;
  }
</style>
